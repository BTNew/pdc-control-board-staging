# Backend environment template for PMB AI intake service
# Copy to the backend host/environment only. Do not commit real values.

# Supabase / database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Microsoft Graph mailbox intake
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX_ADDRESS=
MICROSOFT_GRAPH_WEBHOOK_CLIENT_STATE=

# AI provider
OPENAI_API_KEY=
AI_MODEL=

# App/backend security
APP_API_SECRET=
ALLOWED_ORIGINS=
MAX_ATTACHMENT_BYTES=25000000
RATE_LIMIT_PER_MINUTE=60

# Local Outlook bridge pilot (uses classic Outlook profile on this PC; no mailbox password stored)
OUTLOOK_BRIDGE_MAILBOX=nwmgreception@outlook.com
OUTLOOK_BRIDGE_FOLDER=Inbox
OUTLOOK_BRIDGE_UNREAD_ONLY=true
OUTLOOK_BRIDGE_SAVE_ATTACHMENTS=true
OUTLOOK_BRIDGE_MARK_READ=false
OUTLOOK_BRIDGE_LIMIT=10
OUTLOOK_BRIDGE_MAX_BODY_CHARS=50000

# Optional document extraction helpers
OCR_ENABLED=false
MALWARE_SCAN_ENABLED=false
