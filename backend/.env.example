# Backend environment template for PMB AI intake service
# Copy to the backend host/environment only. Do not commit real values.

# Supabase / database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Microsoft Graph mailbox intake
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX_ADDRESS=
MICROSOFT_GRAPH_WEBHOOK_CLIENT_STATE=

# AI provider
OPENAI_API_KEY=
AI_MODEL=

# App/backend security
APP_API_SECRET=
ALLOWED_ORIGINS=
MAX_ATTACHMENT_BYTES=25000000
RATE_LIMIT_PER_MINUTE=60

# Local IMAP bridge pilot for nwmgreception@outlook.com
# Put real values in backend/.env only; never commit or paste passwords in chat.
IMAP_BRIDGE_HOST=outlook.office365.com
IMAP_BRIDGE_PORT=993
IMAP_BRIDGE_USERNAME=nwmgreception@outlook.com
IMAP_BRIDGE_PASSWORD=
IMAP_BRIDGE_FOLDER=Inbox
IMAP_BRIDGE_LIMIT=10
IMAP_BRIDGE_MAX_BODY_CHARS=50000
IMAP_BRIDGE_MARK_READ=false

# Legacy classic Outlook COM bridge defaults; only useful if classic Outlook desktop is installed.
OUTLOOK_BRIDGE_MAILBOX=nwmgreception@outlook.com
OUTLOOK_BRIDGE_FOLDER=Inbox
OUTLOOK_BRIDGE_UNREAD_ONLY=true
OUTLOOK_BRIDGE_SAVE_ATTACHMENTS=true
OUTLOOK_BRIDGE_MARK_READ=false
OUTLOOK_BRIDGE_LIMIT=10
OUTLOOK_BRIDGE_MAX_BODY_CHARS=50000

# Optional document extraction helpers
OCR_ENABLED=false
MALWARE_SCAN_ENABLED=false
