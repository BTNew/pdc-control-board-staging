{
  "$id": "https://pdc.staging/contracts/board-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "const": "staging"
    },
    "projected_at": {
      "format": "date-time",
      "type": "string"
    },
    "projection_id": {
      "format": "uuid",
      "type": "string"
    },
    "projection_version": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "pdc-email-ai-board-projection-v1"
    },
    "source_readback_receipt_id": {
      "format": "uuid",
      "type": "string"
    },
    "source_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "maxLength": 40,
          "type": "string"
        },
        "location": {
          "maxLength": 40,
          "type": "string"
        },
        "parts": {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "eta": {
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "required",
            "complete",
            "eta"
          ],
          "type": "object"
        },
        "stale": {
          "const": false
        },
        "visible": {
          "type": "boolean"
        },
        "work_groups": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "visible",
        "location",
        "work_groups",
        "parts",
        "lifecycle",
        "stale"
      ],
      "type": "object"
    },
    "vehicle_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "environment",
    "projection_id",
    "vehicle_id",
    "source_readback_receipt_id",
    "source_revision",
    "projection_version",
    "state",
    "projected_at"
  ],
  "title": "PDC Email AI v2 Board projection",
  "type": "object"
}
