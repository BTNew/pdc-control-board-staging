{
  "$defs": {
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "business_rule_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "planner_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "ruleset_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "supabase_action_contract_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "taxonomy_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "transport_release_version": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "transport_release_version",
        "planner_version",
        "model_version",
        "prompt_version",
        "business_rule_version",
        "ruleset_version",
        "taxonomy_version",
        "supabase_action_contract_version",
        "source_digest",
        "evidence_digest"
      ],
      "type": "object"
    },
    "readback": {
      "$id": "https://pdc.staging/contracts/authoritative-readback-v1.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bookings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "booking_id": {
                "format": "uuid",
                "type": "string"
              },
              "out_date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider_id": {
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "return_date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "stage": {
                "maxLength": 40,
                "type": "string"
              },
              "status": {
                "enum": [
                  "planned",
                  "active",
                  "complete",
                  "cancelled"
                ]
              },
              "version": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "booking_id",
              "stage",
              "provider_id",
              "out_date",
              "return_date",
              "version",
              "status"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "environment": {
          "const": "staging"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "backend_record_id": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            },
            "stock_number": {
              "pattern": "^[A-Z0-9][A-Z0-9-]{3,79}$",
              "type": [
                "string",
                "null"
              ]
            },
            "vehicle_id": {
              "format": "uuid",
              "type": "string"
            },
            "vin": {
              "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "vehicle_id",
            "stock_number",
            "vin",
            "backend_record_id"
          ],
          "type": "object"
        },
        "lifecycle": {
          "additionalProperties": false,
          "properties": {
            "collected": {
              "type": "boolean"
            },
            "qc_complete": {
              "type": "boolean"
            },
            "rft_ready": {
              "type": "boolean"
            },
            "status": {
              "maxLength": 40,
              "type": "string"
            }
          },
          "required": [
            "status",
            "qc_complete",
            "rft_ready",
            "collected"
          ],
          "type": "object"
        },
        "location": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "YH",
                "PMB",
                "QC",
                "RFT",
                "OTHER",
                "IT"
              ]
            },
            "source": {
              "enum": [
                "authoritative",
                "unknown"
              ]
            }
          },
          "required": [
            "code",
            "source"
          ],
          "type": "object"
        },
        "operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "completed": {
                "type": "boolean"
              },
              "description": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "estimated_hours": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "hours_provenance": {
                "enum": [
                  "job_card",
                  "catalogue",
                  "ai_estimate",
                  "unknown"
                ]
              },
              "operation_line_id": {
                "format": "uuid",
                "type": "string"
              },
              "operation_no": {
                "maxLength": 40,
                "minLength": 1,
                "type": "string"
              },
              "work_key": {
                "maxLength": 40,
                "minLength": 2,
                "type": "string"
              }
            },
            "required": [
              "operation_line_id",
              "operation_no",
              "description",
              "work_key",
              "estimated_hours",
              "hours_provenance",
              "completed"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "type": "array"
        },
        "parts": {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "eta": {
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "ordered": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "required",
            "ordered",
            "complete",
            "eta"
          ],
          "type": "object"
        },
        "projection_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "read_at": {
          "format": "date-time",
          "type": "string"
        },
        "readback_receipt_id": {
          "format": "uuid",
          "type": "string"
        },
        "required_work": {
          "additionalProperties": false,
          "minProperties": 0,
          "properties": {
            "ELECTRICAL": {
              "type": "boolean"
            },
            "FABRICATION": {
              "type": "boolean"
            },
            "FITTING": {
              "type": "boolean"
            },
            "HOIST": {
              "type": "boolean"
            },
            "PARTS": {
              "type": "boolean"
            },
            "PIT_INSPECTION": {
              "type": "boolean"
            },
            "SUBLET": {
              "type": "boolean"
            },
            "TINT": {
              "type": "boolean"
            },
            "TYRE": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "schema_version": {
          "const": "pdc-email-ai-readback-v1"
        },
        "source_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "vehicle_id": {
          "format": "uuid",
          "type": "string"
        },
        "vehicle_version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "environment",
        "readback_receipt_id",
        "vehicle_id",
        "vehicle_version",
        "source_revision",
        "identity",
        "location",
        "required_work",
        "operations",
        "parts",
        "bookings",
        "lifecycle",
        "read_at",
        "projection_digest"
      ],
      "title": "PDC Email AI v2 authoritative readback",
      "type": "object"
    }
  },
  "$id": "https://pdc.staging/contracts/supabase-action-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "after": {
      "$ref": "#/$defs/readback"
    },
    "audit_event_id": {
      "format": "uuid",
      "type": "string"
    },
    "before": {
      "type": "object"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "APPLIED_AND_VERIFIED",
        "ALREADY_CORRECT",
        "SUPERSEDED",
        "NOT_APPLICABLE",
        "BLOCKED_EXACT_REASON",
        "GENUINELY_AMBIGUOUS",
        "FAILED_QUEUED_RETRY"
      ]
    },
    "environment": {
      "const": "staging"
    },
    "instruction_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "reason": {
      "maxLength": 1000,
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "type": "string"
    },
    "requested": {
      "type": "object"
    },
    "result_code": {
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$",
      "type": "string"
    },
    "schema_version": {
      "const": "pdc-email-ai-action-result-v1"
    }
  },
  "required": [
    "schema_version",
    "environment",
    "request_id",
    "instruction_id",
    "action_key",
    "disposition",
    "result_code",
    "receipt_id",
    "provenance",
    "before",
    "requested",
    "after",
    "audit_event_id",
    "completed_at"
  ],
  "title": "PDC Email AI v2 action result",
  "type": "object"
}
