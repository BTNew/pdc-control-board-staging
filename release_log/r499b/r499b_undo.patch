+.sales-pmb-stations .parts-jita-split.has-jita::after{background:#edf9f1}
+.sales-pmb-stations .parts-jita-split::before{content:'';position:absolute;inset:0;background:linear-gradient(to bottom right,transparent calc(50% - .65px),#64748b 50%,transparent calc(50% + .65px));pointer-events:none}
+.sales-pmb-stations .parts-jita-split .incoming-work-box.parts-jita-parts-marker{position:absolute;left:0;top:0;width:50%;height:50%;font-size:9.5px}
+.sales-pmb-stations .parts-jita-marker{position:absolute;right:0;bottom:0;width:50%;height:50%;display:grid;place-items:center;font-size:9.5px;font-weight:950;line-height:1;color:#a3133b}
+.sales-pmb-stations .has-jita .parts-jita-marker{color:#146c3b}
+.sales-pmb-stations .incoming-work-check.imported-parts-green{background:#edf9f1;color:#168342;border-color:#168342}
+.sales-pmb-stations .incoming-work-check.imported-parts-orange{background:#fff1dc;color:#a15b00;border-color:#d98200}
+.sales-pmb-stations .incoming-work-check.imported-parts-red{background:#fff0f3;color:#ba163c;border-color:#ba163c}
+.sales-pmb-stations .incoming-work-check.imported-parts-grey,.sales-pmb-stations .incoming-work-check.imported-parts-review{background:#eef0f3;color:#536173;border-color:#8995a5}
+.sales-pmb-stations .incoming-work-check:hover{filter:brightness(.98);box-shadow:0 0 0 2px rgba(29,78,216,.14)}
+/* Sublet 'PO to raise' (pdc-sublet-po.js r494): orange, two tiny lines inside the box. */
+.sales-pmb-stations .pdc-sublet-po-count{font-size:9px;font-weight:700;margin-left:2px;opacity:.85;white-space:nowrap}
