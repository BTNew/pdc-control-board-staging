+++ b/sales/pmb-stations.css
@@ -0,0 +1,45 @@
+/* r499 (F112): PMB station icons in the Sales PMB STATUS column. The Control Board's station colours, symbols and Parts / JITA
+   split (styles.css "All ten work tracks" block, imported-parts colours, pdc-sublet-po.js Sublet PO box), scoped to the Sales
+   cell and sized like the compact Vehicle Locations strip (27 x 22 px), shrinking to fit the column. Read only: nothing clicks. */
+.sales-pmb-stations{display:block;margin:0 0 2px;line-height:1}
+.sales-pmb-stations .pdc-station-strip{display:grid;grid-template-columns:repeat(9,minmax(9px,27px));gap:1px;width:auto;max-width:251px;margin:0;padding:0;align-items:center}
+.sales-pmb-stations .incoming-work-check{position:relative;display:grid;place-items:center;box-sizing:border-box;min-width:0;width:100%;height:20px;margin:0;padding:0;gap:0;border:1px solid #d8e0e8;border-radius:3px;background:#f4f6f8;color:#9aa5b1;cursor:help;font-variant-numeric:tabular-nums;font-weight:780;white-space:nowrap;overflow:hidden;pointer-events:auto;user-select:none}
+.sales-pmb-stations .incoming-work-box{display:grid;place-items:center;width:100%;height:100%;border:0;background:transparent;color:inherit;font-size:12px;font-weight:950;line-height:1}
+.sales-pmb-stations .incoming-work-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+.sales-pmb-stations .incoming-work-check.is-not-required{border-color:#d8e0e8;background:#f4f6f8;color:#9aa5b1}
+.sales-pmb-stations .incoming-work-check.is-required{border-color:#ee9caf;background:#fff0f3;color:#a3133b}
+.sales-pmb-stations .incoming-work-check.is-required.is-ordered,.sales-pmb-stations .incoming-work-check.is-ordered,.sales-pmb-stations .incoming-work-check.is-booked{border-color:#fdba74;background:#fff7ed;color:#9a3412}
+.sales-pmb-stations .incoming-work-check.is-complete{border-color:#75c795;background:#edf9f1;color:#146c3b}
+.sales-pmb-stations .incoming-work-check.is-blocked{border-color:#d93434;background:#ffe8e8;color:#9f1111;box-shadow:inset 0 0 0 1px rgba(159,17,17,.12)}
