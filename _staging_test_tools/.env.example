# Environment variables required to run the staging-only Python test
# tools in this directory (_staging_test_tools/). Copy this file to
# `.env` (or export these directly in your shell) and fill in REAL
# values locally -- never commit a filled-in version of this file, and
# never commit a `.env` file. This directory is fully gitignored, but
# this template lives here so a reviewer knows exactly what to provide
# without having to read every test file's source to find out.
#
# All values below are BLANK/FAKE placeholders. None of them are real
# credentials.

# Full PostgreSQL connection string for the STAGING project's Supabase
# connection pooler (session or transaction pooler). Used by
# staging_conn.py for every direct-SQL staging test (schema/catalog
# checks, fixture setup/teardown, row-level verification).
# Format: postgresql://<pooler-user>:<password>@<pooler-host>:<port>/postgres
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection string (choose the pooler connection, not the direct one).
PDC_STAGING_DATABASE_URL=postgresql://postgres.your-staging-project-ref:REPLACE_WITH_YOUR_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres

# Base REST/Auth API URL for the STAGING Supabase project. Used by
# staging_rest.py for every REST/RPC/Auth staging test (sign-in,
# admin user management, RPC calls, direct REST reads/writes used to
# prove RLS/grant behaviour).
# Get this from: Supabase dashboard -> Project Settings -> API -> Project URL.
PDC_STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# The STAGING project's publishable/anon API key. This is NOT a secret
# by Supabase's own design (it is safe to ship in frontend code), but
# it is still project-specific and kept out of committed test source
# so the test tools never assume which project they are pointed at.
# Get this from: Supabase dashboard -> Project Settings -> API -> anon/publishable key.
PDC_STAGING_ANON_KEY=REPLACE_WITH_YOUR_STAGING_ANON_KEY

# The STAGING project's service-role/secret API key. This IS a secret
# -- it bypasses RLS entirely. Used only for admin-level test setup
# (creating/deleting synthetic test accounts via the Auth admin API).
# NEVER expose this in frontend code, NEVER commit a real value for
# this variable, and never use a production service-role key here --
# these test tools are staging-only by design and several of them
# actively refuse to run against anything that doesn't look like the
# staging project.
# Get this from: Supabase dashboard -> Project Settings -> API -> service_role/secret key.
PDC_STAGING_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_STAGING_SERVICE_ROLE_KEY

# Optional, staging-only: the Fernet encryption key used by
# scripts/pdc_backup.py and scripts/pdc_restore.py to encrypt/decrypt
# operational-data backup files. Only needed if you are running the
# backup/restore test tools (test_backup_restore_fk_hardening_staging.py).
# Generate a fresh one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PDC_BACKUP_ENCRYPTION_KEY=
